PORT=3000
PUBLIC_URL=http://localhost:3000
# Use your identity provider. Agent access tokens must have this issuer and audience.
AUTH_ISSUER=https://identity.example.com/
AUTH_JWKS_URI=https://identity.example.com/.well-known/jwks.json
AUTH_AUDIENCE=http://localhost:3000/mcp
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate locally: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
DATABASE_PATH=./data/connector.sqlite
# Publishing is disabled until explicitly enabled by the operator.
ENABLE_PUBLISH=false
